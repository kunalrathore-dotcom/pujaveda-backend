# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_USER_URL=http://localhost:5173
FRONTEND_ADMIN_URL=http://localhost:5174

# MongoDB Atlas Connection
MONGODB_URI=<MONGODB_ATLAS_URI>

# Optional: Override database name if not specified in MONGODB_URI
# MONGODB_DB_NAME=sonic_ecommerce

# Authentication
JWT_SECRET=<STRONG_RANDOM_SECRET>
JWT_EXPIRES_IN=7d

# Brevo SMTP Configuration
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_smtp_user
SMTP_PASS=your_brevo_smtp_password
EMAIL_FROM=your_verified_sender_email

# Upstash Redis
REDIS_URL="rediss://default:your_redis_password@your-redis-host.upstash.io:6379"

# Razorpay Test Configuration
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Admin Credentials (for seed scripts)
ADMIN_NAME=Sonic Admin
ADMIN_EMAIL=jesse@gmail.com
ADMIN_PASSWORD=jesse@123

# Normal User Credentials (for seed scripts)
USER_NAME=Rohan Sharma
USER_EMAIL=rohan1@sonic.com
USER_PASSWORD=Rohan1User@123

